# Keep provider credentials on the server. Never expose these with a VITE_ prefix.
IYONICDB_URL=
IYONICDB_API_KEY=
IYONICMAILER_URL=
IYONICMAILER_API_KEY=
IYONICPAY_URL=
IYONICPAY_API_KEY=
APP_URL=http://localhost:5173

# Admin dashboard credentials (server-side only). The admin inbox opens after a
# successful sign-in verified against these values. Never use VITE_ prefix.
# ADMIN_EMAIL: admin sign-in email
# ADMIN_PASSWORD_HASH: scrypt hash, e.g. scrypt:<salt>:<hex>
#   node --input-type=module -e "import {randomBytes,scryptSync} from 'node:crypto';const s=randomBytes(16).toString('hex');console.log('scrypt:'+s+':'+scryptSync('YOUR_PASSWORD',Buffer.from(s,'hex'),64).toString('hex'))"
# ADMIN_SESSION_SECRET: at least 32 random characters, used to sign session cookies
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
